<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_prueba"
    tools:context=".LastSessionActivity">

    <!-- 🔹 Zócalo fijo arriba -->
    <LinearLayout
        android:id="@+id/zocalo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:padding="16dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:src="@drawable/logovmoov_v"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- 🔹 CardView que contiene TODO -->
    <androidx.cardview.widget.CardView
        android:id="@+id/chart_card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        android:padding="22dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/zocalo"
        app:layout_constraintBottom_toTopOf="@id/horizontalBottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:paddingHorizontal="0dp"
            android:gravity="center">

            <!-- 🔹 Encabezado dentro de la CardView -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Última Partida:"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    style="@style/titulo"
                    android:textColor="@color/violet"/>

                <TextView
                    android:id="@+id/game_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del juego"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    style="@style/titulo"
                    android:textColor="@color/blue"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/subtitle_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01/01/2025"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                style="@style/cuerpobold"
                android:textStyle="bold"
                android:textColor="@color/blue"
                android:gravity="center"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/violet"
                android:layout_marginTop="10dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"/>


            <!-- 🔹 Título y Descripción del gráfico -->
            <TextView
                android:id="@+id/chart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título del gráfico"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/blue"
                style="@style/titulo"
                android:layout_marginTop="12dp"/>

            <TextView
                android:id="@+id/chart_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción breve del gráfico."
                android:textSize="12sp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                style="@style/cuerpo"
                android:textColor="@color/blue"
                android:layout_marginTop="4dp"/>

            <!-- 🔹 ViewPager2 para los gráficos -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@id/chart_description"
                app:layout_constraintBottom_toTopOf="@id/tab_layout"/>



            <!-- 🔹 Indicador de página (puntos debajo del gráfico) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/lightviolet"
                android:background="@color/lightviolet"
                app:tabIndicatorColor="@color/blue"
                app:tabSelectedTextColor="@color/blue"
                app:tabTextColor="@color/violet"/>

            <!-- 🔹 Frase motivacional -->
            <TextView
                android:id="@+id/motivational_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Sigue así, estás mejorando cada día!"
                android:textSize="12sp"
                android:textStyle="italic"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                style="@style/cuerpobold"
                android:textColor="@color/blue"
                android:gravity="center"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 🔹 Botones fijos abajo -->
    <LinearLayout
        android:id="@+id/botones_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Zócalo inferior con botones -->
        <androidx.cardview.widget.CardView
            android:id="@+id/zocalo_card"
            android:layout_width="match_parent"
            android:layout_marginBottom="-12dp"
            android:layout_height="80dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:id="@+id/gridButtons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:gravity="center">

                <ImageButton
                    android:id="@+id/back_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:paddingBottom="20dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/home"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/horizontalBottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.93" />

</androidx.constraintlayout.widget.ConstraintLayout>
