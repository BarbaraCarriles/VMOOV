<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_prueba"
    android:orientation="vertical">

    <!-- 🔹 Zócalo blanco con logo -->
    <LinearLayout
        android:id="@+id/zocalo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:padding="16dp"
        android:gravity="center">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:contentDescription="Logo VMOOV"
            android:src="@drawable/logovmoov_v"
            android:scaleType="fitCenter"/>
    </LinearLayout>

    <!-- 🔹 CardView para los Spinners -->
    <androidx.cardview.widget.CardView
        android:id="@+id/spinner_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginVertical="14dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp">

            <!-- Fila 1: Número y Tipo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinner_number"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/spinner_background"
                    android:entries="@array/number_array"
                    android:spinnerMode="dropdown"/>

                <Spinner
                    android:id="@+id/spinner_type"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="2"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/spinner_background"
                    android:entries="@array/type_array"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

            <!-- Fila 2: Juego -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="12dp">

                <Spinner
                    android:id="@+id/spinner_game"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:entries="@array/game_array"
                    android:spinnerMode="dropdown"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- 🔹 CardView para el gráfico y TabLayout -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="18dp"
        android:layout_marginVertical="14dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="0dp">

            <!-- 🔹 ViewPager2 para los gráficos -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <!-- 🔹 TabLayout para los tabs (colocado debajo del gráfico) -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/lightviolet"
                android:background="@color/lightviolet"
                app:tabIndicatorColor="@color/blue"
                app:tabSelectedTextColor="@color/blue"
                app:tabTextColor="@color/violet"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 🔹 Botón "Volver" -->
    <androidx.cardview.widget.CardView
        android:id="@+id/back_button"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        android:layout_marginBottom="12dp"
        android:backgroundTint="@color/violet"
        android:padding="14dp"
        android:layout_gravity="center_horizontal">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="14dp"/>
    </androidx.cardview.widget.CardView>

</LinearLayout>
